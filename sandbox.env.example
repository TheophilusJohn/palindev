# Copy to .env.sandbox (gitignored) and fill in. Sandbox and test accounts ONLY.
# Claude Code is blocked from reading .env files; fill this in yourself.

# --- Harness controls ---
PALIN_HARNESS_DISABLED=0          # 1 stops every sandbox run at preflight; mock runs ignore it
PALIN_ALLOW_BILLABLE=0            # 1 permits actions that can cost money (see Billable actions in docs/HARNESS.md)

# --- Probes (only if a provider's own APIs can't observe; see docs/HARNESS.md) ---
PALIN_PROBE_WEBHOOK_URL=          # deployed webhook Worker URL (yours; never a third-party request bin)
PALIN_PROBE_MAIL_DOMAIN=          # e.g. probe.palin.dev
PALIN_PROBE_READ_TOKEN=           # token the harness uses to read probe events

# --- GitHub (week 2, D25): the harness acts as a GitHub App installed only on the test org ---
# Never use your personal account or a personal token here. Preflight refuses TheophilusJohn and the real palindev org.
GITHUB_SANDBOX_ORG=               # tenant allowlist: the test org's login
GITHUB_APP_ID=                    # the App is registered under the test org as private ("Only on this account")
GITHUB_APP_INSTALLATION_ID=       # the App's one installation, on the test org
GITHUB_APP_PRIVATE_KEY_B64=       # the App's private key (PEM), base64-encoded; then delete the .pem or keep it outside the repo
GITHUB_OBSERVER_LOGIN=            # the one dedicated machine account that observes
GITHUB_OBSERVER_TOKEN=            # that account's classic token with only the notifications and read:org scopes (the notifications API accepts classic tokens only; GET /user/orgs needs read:org; test repos are public)

# --- AWS (week 3, D14): dedicated account in the Organization ---
AWS_SANDBOX_ACCOUNT_ID=           # tenant allowlist
AWS_SANDBOX_ORG_ID=               # the Organization's id (o-...); preflight refuses any other
AWS_SANDBOX_ACCESS_KEY_ID=
AWS_SANDBOX_SECRET_ACCESS_KEY=
AWS_SANDBOX_SESSION_TOKEN=        # only with temporary credentials (IAM Identity Center or STS)
AWS_SANDBOX_REGION=               # the one region the service control policy allows

# --- Stripe (stretch, weeks 9 to 12; only once terms are green or consent is on file, V24) ---
# Test mode only; the key must start with sk_test_ or rk_test_.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_ACCOUNT_ID=           # acct_... of the test account, for the tenant allowlist
