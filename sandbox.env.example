# Copy to .env.sandbox (gitignored) and fill in. Sandbox and test accounts ONLY.
# Claude Code is blocked from reading .env files; fill this in yourself.

# --- Harness controls ---
PALIN_HARNESS_DISABLED=0          # 1 stops every sandbox run at preflight
PALIN_ALLOW_BILLABLE=0            # 1 permits actions that can cost money (needs a spend cap)

# --- Probes (week 3) ---
PALIN_PROBE_WEBHOOK_URL=          # deployed webhook Worker URL
PALIN_PROBE_MAIL_DOMAIN=          # e.g. probe.palin.dev
PALIN_PROBE_READ_TOKEN=           # token the harness uses to read probe events

# --- GitHub (week 3): a throwaway org, fine-grained token scoped to it ---
GITHUB_SANDBOX_ORG=
GITHUB_SANDBOX_TOKEN=
GITHUB_OBSERVER_TOKEN=            # second test account, for observer probes

# --- Stripe (week 4): test mode only; must start with sk_test_ or rk_test_ ---
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_ACCOUNT_ID=           # acct_... of the test account, for the tenant allowlist

# --- Slack (week 5): free developer workspace ---
SLACK_SANDBOX_TEAM_ID=
SLACK_SANDBOX_BOT_TOKEN=
SLACK_OBSERVER_USER_TOKEN=

# --- Google Workspace (week 6): test domain accounts ---
GOOGLE_SANDBOX_DOMAIN=
GOOGLE_SANDBOX_CREDENTIALS_PATH=  # path to a service-account or OAuth file OUTSIDE the repo

# --- Notion, Linear (week 8) ---
NOTION_SANDBOX_TOKEN=
LINEAR_SANDBOX_API_KEY=

# --- AWS (week 9): separate account with a budget alarm ---
AWS_SANDBOX_PROFILE=              # named profile in ~/.aws/config, never keys here
AWS_SANDBOX_ACCOUNT_ID=
